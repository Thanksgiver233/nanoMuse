{
  "schema_version": 2,
  "dataset_version": "goal-eval.recovery.v2",
  "world_version": "local-action-world.v1",
  "label_provenance": "AI-authored synthetic cases with independent review, not human-labelled production data. The first 25 were written before the two pre_fix defects were found and the other 18 after, so the 18 are regression cases, not held-out validation.",
  "scope": "Sequential controlled execution through MuseAgent, MockLLM and Sentinel; no real model improvement claim",
  "handling_contract": {
    "completed": "Correct effect is supported by a matching current receipt or authoritative lookup",
    "unresolved": "Effect cannot be established with available observations, including observation-budget exhaustion",
    "blocked": "Write authorization is unavailable; reads remain permitted by this synthetic service contract",
    "conflict": "The obligation key has incompatible existing content",
    "budget_exhausted": "Commit attempts exhausted and a current authoritative read confirms no effect; unknown state must be unresolved"
  },
  "fault_schedule_contract": "Fault index is global across commit attempts and triggers within a case; lookup mode index is global across lookups. Last schedule item repeats. The schedule and oracle labels are hidden from the actor.",
  "service_semantics": "If native idempotency is advertised, commits are atomic by obligation key. An existing key returns its stored content and never inserts a second row, even on conflicting input.",
  "anomaly_rule": "Only unavailable/pending lookup permits the idempotent fallback. Misbound/stale data is an anomaly; a current bound receipt with conflicting effects is reported as conflict.",
  "service_contract": {
    "key_semantics": "obligation identity; atomic service deduplication only when idempotent_by_key is true",
    "read_lookup_allowed_after_write_revocation": true,
    "lookup_consumes_commit_attempts": false,
    "clock": 1000
  },
  "defaults": {
    "requests": [{"key": "obligation-a", "subject": "calendar:event-a", "payload": "payload-v1"}],
    "triggers": ["obligation-a"],
    "faults": ["ok"],
    "lookup_modes": ["ok"],
    "authorization": "approved",
    "initial_effects": [],
    "service_idempotent": false,
    "max_attempts": 3,
    "max_calls": 12,
    "observer_available": true
  },
